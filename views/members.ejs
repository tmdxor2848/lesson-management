<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>회원 관리</title>
</head>

<body>
  <h1>회원 관리</h1>
  <h2>회원 등록</h2>
  <form action="/members" method="POST">
    <p>이름</p>
    <input type="text" name="name" required>
    <p>생년월일</p>
    <input type="date" name="birth" required>
    <p>성별</p>
    <label for="">
      <input type="radio" name="gender" value="남">남
    </label>
    <label for="">
      <input type="radio" name="gender" value="여">여
    </label>
    <p>전화번호</p>
    <input type="text" name="phone" placeholder="010-1234-5678">
    <p>메모</p>
    <textarea name="memo" rows="4" cols="30"></textarea>
    <br><br>
    <button type="submit">회원 등록</button>
  </form>
  <hr>

  <h2>등록된 회원</h2>

  <% members.forEach(member=> { %>

    <div>

      <h3>
        <%= member.name %>
      </h3>

      <p>
        생년월일 :
        <%= member.birth.toISOString().slice(0, 10) %>
      </p>

      <p>
        성별 :
        <%= member.gender %>
      </p>

      <p>
        전화번호 :
        <%= member.phone %>
      </p>

      <p>
        상태 :

        <% if (member.status==='ACTIVE' ) { %>
          레슨중

          <% } else if (member.status==='PAUSED' ) { %>
            휴식중

            <% } else if (member.status==='WAITING' ) { %>
              대기중

              <% } else if (member.status==='QUIT' ) { %>
                탈퇴

                <% } %>
      </p>

      <p>
        가입일 :
        <%= member.joined_date.toISOString().slice(0, 10) %>
      </p>

      <p>
        메모 :
        <%= member.memo %>
      </p>

      <a href="/members/<%= member.id %>/edit">
        <button type="button">수정</button>
      </a>

    </div>

    <hr>

    <% }); %>
      <br>
      <a href="/">
        <button type="button">메인으로</button>
      </a>
</body>

</html>