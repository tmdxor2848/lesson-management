<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>이월 수정</title>
</head>

<body>

  <h1>이월 수정</h1>

  <p>
    회원 :
    <strong>
      <%= carry.member_name %>
    </strong>
  </p>

  <p>
    레슨방 :
    <%= carry.room_name %>
  </p>

  <p>
    이월 :
    <%= carry.from_year %>년
      <%= carry.from_month %>월
        →
        <%= carry.to_year %>년
          <%= carry.to_month %>월
  </p>

  <form action="/carry-over-edit/<%= carry.carry_id %>" method="POST">

    <p>이월 횟수</p>

    <input type="number" name="carry_count" min="1" value="<%= carry.carry_count %>" required>

    <br><br>

    <button type="submit">
      수정 완료
    </button>

  </form>

  <br>

  <form action="/carry-over-delete/<%= carry.carry_id %>" method="POST">

    <button type="submit">
      이월 취소
    </button>

  </form>

  <br>

  <a href="/lesson-members">
    <button type="button">
      돌아가기
    </button>
  </a>

</body>

</html>