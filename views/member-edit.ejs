<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>회원 수정</title>
</head>

<body>

  <h1>회원 수정</h1>

  <form action="/members/<%= member.id %>/edit" method="POST">

    <input type="hidden" name="from" value="<%= from %>">

    <p>이름</p>
    <input type="text" name="name" value="<%= member.name %>">

    <p>생년월일</p>
    <input type="date" name="birth" value="<%= member.birth.toISOString().slice(0, 10) %>">

    <p>성별</p>

    <label>
      <input type="radio" name="gender" value="남" <%=member.gender==='남' ? 'checked' : '' %>
      >
      남
    </label>

    <label>
      <input type="radio" name="gender" value="여" <%=member.gender==='여' ? 'checked' : '' %>
      >
      여
    </label>

    <p>전화번호</p>
    <input type="text" name="phone" value="<%= member.phone %>">

    <p>상태</p>

    <select name="status">

      <option value="ACTIVE" <%=member.status==='ACTIVE' ? 'selected' : '' %>>
        레슨중
      </option>

      <option value="PAUSED" <%=member.status==='PAUSED' ? 'selected' : '' %>>
        휴식중
      </option>

      <option value="WAITING" <%=member.status==='WAITING' ? 'selected' : '' %>>
        대기중
      </option>

      <option value="QUIT" <%=member.status==='QUIT' ? 'selected' : '' %>>
        탈퇴
      </option>

    </select>

    <p>메모</p>

    <textarea name="memo" rows="4" cols="40"><%= member.memo || '' %></textarea>


    <hr>

    <h2>상시 할인 설정</h2>


    <label>

      <input type="checkbox" name="discount_active" value="1" <%=discount ? 'checked' : '' %>
      >

      상시 할인 적용

    </label>


    <p>할인 이름</p>

    <input type="text" name="discount_name" value="<%= discount ? discount.discount_name : '' %>"
      placeholder="예: 레슨반장 할인">


    <p>할인 방식</p>

    <select name="discount_type">

      <option value="PERCENT" <%=discount && discount.discount_type==='PERCENT' ? 'selected' : '' %>
        >
        퍼센트 할인
      </option>

      <option value="FIXED" <%=discount && discount.discount_type==='FIXED' ? 'selected' : '' %>
        >
        고정 금액 할인
      </option>

    </select>


    <p>할인 값</p>

    <input type="number" name="discount_value" min="0" step="0.01"
      value="<%= discount ? discount.discount_value : '' %>" placeholder="예: 50">


    <p>할인 시작일</p>

    <input type="date" name="discount_start_date" value="<%=
    discount && discount.start_date
      ? discount.start_date.toISOString().slice(0, 10)
      : ''
  %>">


    <p>할인 종료일</p>

    <input type="date" name="discount_end_date" value="<%=
    discount && discount.end_date
      ? discount.end_date.toISOString().slice(0, 10)
      : ''
  %>">

    <p>
      종료일을 비워두면 계속 적용됩니다.
    </p>


    <p>할인 메모</p>

    <textarea name="discount_memo" rows="3" cols="40"><%= discount ? (discount.memo || '') : '' %></textarea>


    <br><br>

    <button type="submit">
      수정 완료
    </button>

  </form>

  <a href="/members">
    <button type="button">취소</button>
  </a>

</body>

</html>